{
  "name": "chat-app",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:api": "npm run start:dev:embedded -w @chat-app/api",
    "dev:api:watch": "npm run start:dev -w @chat-app/api",
    "dev:web": "npm run dev -w @chat-app/web",
    "dev": "concurrently -n api,web -c blue,green \"npm run dev:api\" \"npm run dev:web\"",
    "build:api": "npm run build -w @chat-app/api",
    "build:web": "npm run build -w @chat-app/web",
    "build": "npm run build:api && npm run build:web",
    "test:api": "npm run test -w @chat-app/api",
    "test:web": "npm run test -w @chat-app/web",
    "test:e2e": "npm run test:e2e -w @chat-app/web",
    "test": "npm run test:api && npm run test:web",
    "seed": "npm run seed -w @chat-app/api",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}

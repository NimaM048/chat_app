# API
PORT=3000
DATABASE_URL=postgresql://chat_user:chat_password@localhost:5432/chat_app?schema=public
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
REDIS_URL=redis://localhost:6379
CORS_ORIGIN=http://localhost:5173

# Web (local Vite)
VITE_API_URL=/api/v1
VITE_SOCKET_URL=http://localhost:3000

# Docker / Compose
# CORS_ORIGIN=http://localhost
